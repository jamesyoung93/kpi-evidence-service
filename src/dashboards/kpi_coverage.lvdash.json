{
  "datasets": [
    {
      "name": "ds_published",
      "displayName": "Published values (current)",
      "queryLines": [
        "SELECT brand, kpi_id, scope_key, period_label, period_end, value, unit, display_label,\n",
        "  validation_status, platform_value, variance_rel, evidence_uri, approved_by, approved_at\n",
        "FROM published_kpis_current"
      ]
    },
    {
      "name": "ds_results_by_status",
      "displayName": "Current results by status",
      "queryLines": [
        "SELECT\n",
        "  brand, status_group,\n",
        "  CASE status_group\n",
        "    WHEN 'GOOD' THEN 'Good'\n",
        "    WHEN 'REVIEW' THEN 'Needs review'\n",
        "    WHEN 'BLOCKED' THEN 'Blocked'\n",
        "    ELSE 'Unknown status'\n",
        "  END AS group_name,\n",
        "  status_label, status_sort,\n",
        "  COUNT(*) AS results\n",
        "FROM kpi_results_current\n",
        "GROUP BY brand, status_group, status_label, status_sort"
      ]
    },
    {
      "name": "ds_review_open",
      "displayName": "Open review items",
      "queryLines": [
        "SELECT brand, kpi_id, period_label, period_end, validation_status, status_label, status_sort,\n",
        "  reason_code, reason_detail, report_value, platform_value, file_name, slide_or_page, created_at\n",
        "FROM review_open"
      ]
    },
    {
      "name": "ds_dq_latest",
      "displayName": "Latest data-quality check run",
      "queryLines": [
        "WITH latest AS (\n",
        "  SELECT check_run_id FROM dq_results ORDER BY checked_at DESC LIMIT 1\n",
        ")\n",
        "SELECT d.object_name, d.check_name, d.severity, d.passed, d.violations, d.detail, d.checked_at,\n",
        "  CASE WHEN d.severity = 'hard' AND NOT d.passed THEN 1 ELSE 0 END AS hard_failure\n",
        "FROM dq_results AS d\n",
        "JOIN latest AS l ON d.check_run_id = l.check_run_id"
      ]
    }
  ],
  "pages": [
    {
      "name": "p_coverage",
      "displayName": "Coverage and review",
      "pageType": "PAGE_TYPE_CANVAS",
      "layout": [
        {
          "widget": {
            "name": "w_header",
            "multilineTextboxSpec": {
              "lines": [
                "## KPI evidence: coverage and review\n",
                "Published values, current results by status, the open review queue and the latest data-quality checks. Statuses use the same plain names as the review app. Every published value links to its source file in the app's Published KPIs page."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "w_published",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_published",
                  "fields": [
                    {
                      "name": "count(*)",
                      "expression": "COUNT(`*`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "count(*)",
                  "displayName": "Published values"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Published values",
                "showDescription": true,
                "description": "Current published values (reviewer-approved or published by the automatic policy)."
              }
            }
          },
          "position": {
            "x": 0,
            "y": 2,
            "width": 2,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "w_review_open",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_review_open",
                  "fields": [
                    {
                      "name": "count(*)",
                      "expression": "COUNT(`*`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "count(*)",
                  "displayName": "Open review items"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Open review items",
                "showDescription": true,
                "description": "Results that wait for a person: review and blocked groups without a decision."
              }
            }
          },
          "position": {
            "x": 2,
            "y": 2,
            "width": 2,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "w_dq_hard",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_dq_latest",
                  "fields": [
                    {
                      "name": "sum(hard_failure)",
                      "expression": "SUM(`hard_failure`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "sum(hard_failure)",
                  "displayName": "Hard data-quality failures"
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Hard data-quality failures",
                "showDescription": true,
                "description": "Hard checks that failed in the latest run. A failure marks dependent KPIs as a platform data issue."
              }
            }
          },
          "position": {
            "x": 4,
            "y": 2,
            "width": 2,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "w_results_by_status",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_results_by_status",
                  "fields": [
                    {
                      "name": "group_name",
                      "expression": "`group_name`"
