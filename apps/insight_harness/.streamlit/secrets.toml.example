# Copy this file to .streamlit/secrets.toml and replace placeholders.
# Never commit the real secrets.toml file.

# Optional. Visitors still use the deterministic parser unless public use is
# explicitly enabled below; they may always enter their own session key.
ANTHROPIC_API_KEY = "your-key"
INSIGHT_HARNESS_ALLOW_PUBLIC_LLM = "false"
INSIGHT_HARNESS_LLM_SESSION_LIMIT = "25"
INSIGHT_HARNESS_LLM_MODELS = "claude-sonnet-5,claude-haiku-4-5,claude-opus-4-8"

# Optional. Without this token the public app's governance controls are
# read-only and causal analyst sign-off is locked. Use a long random value and
# enter it only in a trusted session.
INSIGHT_HARNESS_GOVERNANCE_ADMIN_TOKEN = "replace-with-a-long-random-token"

# Optional. Leave unset for unlinkable per-process feedback identifiers. Set a
# long random secret only when stable cross-restart correlation is approved.
INSIGHT_HARNESS_TELEMETRY_HASH_KEY = "replace-with-a-long-random-secret"

# Raw user questions are excluded from feedback telemetry by default.
INSIGHT_HARNESS_LOG_RAW_QUESTIONS = "false"
